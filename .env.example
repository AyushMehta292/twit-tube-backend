PORT=8000

# MongoDB Atlas — base URL without database name (app appends /twit-tube)
MONGODB_URL=mongodb+srv://user:pass@cluster.mongodb.net

# JWT secrets — generate with: openssl rand -base64 32
ACCESS_TOKEN_SECRET=your-access-token-secret
REFRESH_TOKEN_SECRET=your-refresh-token-secret
ACCESS_TOKEN_EXPIRY=1d
REFRESH_TOKEN_EXPIRY=10d

# CORS — local + production frontend URLs
CORS_ORIGIN_LOCAL=http://localhost:5173
CORS_ORIGIN_PROD=https://your-production-frontend.vercel.app
FRONTEND_URL=https://your-production-frontend.vercel.app

# Cloudinary (video/avatar uploads)
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret
